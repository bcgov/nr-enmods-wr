
if (NR == 1) {
  print "[mlr] Miller script started. Processing records..." > "/dev/stderr";
}

for (k in $*) {
  if ($[k] == "") {
    $[k] = "";
  }
}

if ($["Field_Visit_Start_Time"] != "" && !($["Field_Visit_Start_Time"] =~ "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$")) {
  print "[mlr] Normalizing Field_Visit_Start_Time: " . $["Field_Visit_Start_Time"] > "/dev/stderr";
  $["Field_Visit_Start_Time"] = strftime(strptime($["Field_Visit_Start_Time"], "%Y-%m-%d %H:%M:%S"), "%Y-%m-%dT%H:%M:%S-07:00");
}

if ($["Field_Visit_End_Time"] != "" && !($["Field_Visit_End_Time"] =~ "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$")) {
  print "[mlr] Normalizing Field_Visit_End_Time: " . $["Field_Visit_End_Time"] > "/dev/stderr";
  $["Field_Visit_End_Time"] = strftime(strptime($["Field_Visit_End_Time"], "%Y-%m-%d %H:%M:%S"), "%Y-%m-%dT%H:%M:%S-07:00");
}

