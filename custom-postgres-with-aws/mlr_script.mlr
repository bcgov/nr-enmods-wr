}

if ($["Observed_Date_Time_Start"] != "" && !($["Observed_Date_Time_Start"] =~ "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$")) {
  print "[mlr] Normalizing Observed_Date_Time_Start: " . $["Observed_Date_Time_Start"] > "/dev/stderr";
  $["Observed_Date_Time_Start"] = strftime(strptime($["Observed_Date_Time_Start"], "%Y-%m-%d %H:%M:%S"), "%Y-%m-%dT%H:%M:%S-07:00");
}

if ($["Observed_Date_Time_End"] != "" && !($["Observed_Date_Time_End"] =~ "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$")) {
  print "[mlr] Normalizing Observed_Date_Time_End: " . $["Observed_Date_Time_End"] > "/dev/stderr";
