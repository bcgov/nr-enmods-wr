}

if ($["Analyzed_Date_Time"] != "" && !($["Analyzed_Date_Time"] =~ "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$")) {
