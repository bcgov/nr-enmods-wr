if ($["Lab_Arrival_Date_Time"] != "" && !($["Lab_Arrival_Date_Time"] =~ "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$")) {
