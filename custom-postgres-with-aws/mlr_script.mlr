func iso8601_to_utc(s) {
    if (s == "" || s == "\N" || s == "NULL") { return s }

    local dt_str = "";
    local offset_str = "";

    if (string(s) =~ "Z$") {
        dt_str     = sub(s, "Z$", "");
        offset_str = "+00:00";
    } else {
        dt_str     = substr(s, 0, strlen(s) - 7);
        offset_str = substr(s, strlen(s) - 6, -1);
    }

    local sign     = (substr(offset_str, 0, 0) == "-") ? -1 : 1;
    local off_h    = int(substr(offset_str, 1, 2));
    local off_m    = int(substr(offset_str, 4, 5));
    local off_secs = sign * (off_h * 3600 + off_m * 60);

    local epoch_utc = strptime(dt_str, "%Y-%m-%dT%H:%M:%S") - off_secs;
    return strftime(epoch_utc, "%Y-%m-%dT%H:%M:%S+00:00");
}

# Passthrough empty strings for all fields
for (k in $*) {
    if ($[k] == "") { $[k] = ""; }
}

# Replace with your actual 8 timestamp column names
$Field_Visit_Start_Time = iso8601_to_utc($Field_Visit_Start_Time);
$Field_Visit_End_Time = iso8601_to_utc($Field_Visit_End_Time);
$Observed_Date_Time = iso8601_to_utc($Observed_Date_Time);
$Observed_Date_Time_Start = iso8601_to_utc($Observed_Date_Time_Start);
$Observed_Date_Time_End = iso8601_to_utc($Observed_Date_Time_End);
$Analyzed_Date_Time = iso8601_to_utc($Analyzed_Date_Time);
$Lab_Arrival_Date_Time = iso8601_to_utc($Lab_Arrival_Date_Time);
$Lab_Prepared_Date_Time = iso8601_to_utc($Lab_Prepared_Date_Time);